#, python-format
msgid "Hi %(name)s,"
msgstr "Hola %(name)s,"

#: base/templates/base/emails/admin_message.html:7
msgid "— The Coffee Circuit team"
msgstr ""

#: base/templates/base/emails/connection_request_created.html:5
#, python-format
msgid "<strong>%(name)s</strong> wants to connect with you on Coffee Circuit."
msgstr "<strong>%(name)s</strong> quiere conectar contigo en Coffee Circuit."

#: base/templates/base/emails/connection_request_created.html:7
#: base/templates/base/emails/meeting_request_created.html:8
msgid "Message:"
msgstr "Mensaje:"

#: base/templates/base/emails/connection_request_created.html:9
#: base/templates/base/emails/meeting_request_created.html:10
msgid "Sign in to your dashboard to accept or decline the request."
msgstr ""
"Inicia sesión y verifica tu tablero para aceptar o rechazar la solicitud."

#: base/templates/base/emails/connection_request_decision.html:6
#, python-format
msgid ""
"<strong>%(name)s</strong> accepted your connection request. You're now "
"connected."
msgstr ""
"<strong>%(name)s</strong> aceptó tu solicitud de conexión. Ahora ambos están "
"conectados."

#: base/templates/base/emails/connection_request_decision.html:7
msgid "Sign in to your dashboard to message them and follow up."
msgstr ""
"Inicia sesión y verifica tu tablero para empezar a intercambiar mensajes."

#: base/templates/base/emails/connection_request_decision.html:9
#, python-format
msgid "<strong>%(name)s</strong> declined your connection request."
msgstr "<strong>%(name)s</strong> rechazó tu solicitud de conexión."

#: base/templates/base/emails/connection_request_decision.html:10
msgid ""
"Don't worry — you can still browse and connect with others from your "
"dashboard."
msgstr ""
"No te preocupes. Todavía puedes buscar y conectar con otros desde tu tablero."

#: base/templates/base/emails/forum_meeting_decision.html:6
#, python-format
msgid ""
"<strong>%(name)s</strong> confirmed your proposed meeting time for <strong>"
"%(title)s</strong>."
msgstr ""
"<strong>%(name)s</strong> confirmó la reunión que le propusiste en el "
"<strong>%(title)s</strong>."

#: base/templates/base/emails/forum_meeting_decision.html:8
#, python-format
msgid ""
"<strong>%(name)s</strong> declined your proposed meeting time for <strong>"
"%(title)s</strong>."
msgstr ""
"<strong>%(name)s</strong> rechazó la reunión que propusiste para el <strong>"
"%(title)s</strong>."

#: base/templates/base/emails/forum_meeting_decision.html:11
#: base/templates/base/emails/forum_meeting_proposed.html:7
#: base/templates/base/emails/meeting_calendar_invite.html:7
msgid "When:"
msgstr "Hora:"

#: base/templates/base/emails/forum_meeting_decision.html:13
msgid "Open your chat for details."
msgstr "Abra el chat para ver más."

#: base/templates/base/emails/forum_meeting_proposed.html:5
#, python-format
msgid ""
"<strong>%(name)s</strong> proposed a meeting time for <strong>%(title)s</"
"strong>."
msgstr ""
"<strong>%(name)s</strong> te invitó a una reunión en el <strong>%(title)s</"
"strong>."

#: base/templates/base/emails/forum_meeting_proposed.html:10
#, python-format
msgid ""
"You're not signed up for %(title)s yet &mdash; confirming this time signs "
"you up."
msgstr ""

#: base/templates/base/emails/forum_meeting_proposed.html:12
msgid "Open your chat to confirm or decline the time."
msgstr "Abra el chat para confirmar o rechazar la hora."

#: base/templates/base/emails/meeting_calendar_invite.html:5
#, python-format
msgid ""
"Your meeting with <strong>%(name)s</strong> for <strong>%(title)s</strong> "
"is confirmed. A calendar invite is attached to this email."
msgstr ""
"Tu reunión con <strong>%(name)s</strong> en el <strong>%(title)s</strong> "
"está confirmada. La invitación de calendario se encuentra en el anexo de "
"este correo."

#: base/templates/base/emails/meeting_calendar_invite.html:11
msgid "Join:"
msgstr "Unirse:"

#: base/templates/base/emails/meeting_calendar_invite.html:14
msgid "Add the attached invite to your calendar so you don't miss it."
msgstr "Agrega la invitación a tu calendario para no perderla."

#: base/templates/base/emails/meeting_request_created.html:5
#, python-format
msgid "<strong>%(name)s</strong> sent you a meeting request on Coffee Circuit."
msgstr ""
"<strong>%(name)s</strong> te envió una solicitud de reunión en el Coffee "
"Circuit."

#: base/templates/base/emails/meeting_request_created.html:6
#: base/templates/base/emails/meeting_request_decision.html:7
#, python-format
msgid "<strong>Proposed time:</strong> %(time)s EST"
msgstr "<strong>Hora propuesta:</strong> %(time)s hora de Nueva York"

#: base/templates/base/emails/meeting_request_decision.html:6
#, python-format
msgid "<strong>%(name)s</strong> accepted your meeting request."
msgstr "<strong>%(name)s</strong> aceptó tu solicitud de reunión."

#: base/templates/base/emails/meeting_request_decision.html:8
msgid "Sign in to your dashboard to view the details and follow up."
msgstr "Ingresa a tu cuenta para ver los detalles y hacer seguimiento."

#: base/templates/base/emails/meeting_request_decision.html:10
#, python-format
msgid "<strong>%(name)s</strong> declined your meeting request."
msgstr "<strong>%(name)s</strong> rechazó tu solicitud de reunión."

#: base/templates/base/emails/meeting_request_decision.html:11
msgid ""
"Don't worry — you can still browse other connections from your dashboard."
msgstr ""
"No te preocupes — aún puedes ver otras conexiones desde tu cuenta y "
"solicitar otra reunión."

#: base/templates/base/emails/welcome.html:5
msgid ""
"Welcome to Coffee Circuit — the place where coffee roasters and producers "
"find each other."
msgstr ""
"Te damos la bienvenida a Coffee Circuit, el lugar donde tostadores y "
"productores pueden encontrarse."

#: base/templates/base/emails/welcome.html:7
msgid ""
"To get started, finish your profile and share your story so roasters can "
"discover you."
msgstr ""
"Para empezar, completa tu perfil y comparte tu historia para que los "
"tostadores puedan encontrarte."

#: base/templates/base/emails/welcome.html:9
msgid ""
"To get started, finish your profile and start browsing producers to connect "
"with."
msgstr ""
"Para empezar, finaliza tu perfil y empieza a buscar productores con quienes "
"te interesa conectar."

#: base/templates/base/template_verify_email.html:5
